{
    "name": "form-builder",
    "version": "1.6.0",
    "title": "Form Builder",
    "icon": "icon.png",
    "description": "Production form builder with multilingual definitions, private validated uploads, idempotent public submissions, configurable review workflows, Core Mail notifications, CSV export, and shortcode/theme-section embedding.",
    "author": "Adam Muiz",
    "author_uri": "https://jyavani.com/member/adammuiz/",
    "plugin_uri": "https://jyavani.com/plugin/form-builder/",
    "homepage": "https://jyavani.com/plugin/form-builder/",
    "requires": {
        "jyavani": ">=2.3.122",
        "php": ">=8.1",
        "extensions": [
            "pdo",
            "pdo_mysql",
            "fileinfo",
            "dom",
            "json",
            "mbstring"
        ]
    },
    "permissions": [
        {
            "key": "plugin.form-builder.workspace.access",
            "label": "Access Form Builder",
            "supports_scope": false,
            "default_roles": [
                "author",
                "admin"
            ]
        },
        {
            "key": "plugin.form-builder.forms.manage-any",
            "label": "Manage Any Form",
            "supports_scope": false,
            "default_roles": [
                "admin"
            ],
            "delegable": true
        },
        {
            "key": "plugin.form-builder.submissions.manage",
            "label": "Manage Form Submissions",
            "supports_scope": false,
            "default_roles": ["admin"],
            "delegable": true
        },
        {
            "key": "plugin.form-builder.workflow.manage",
            "label": "Manage Submission Workflow",
            "supports_scope": false,
            "default_roles": ["admin"],
            "delegable": true
        },
        {
            "key": "plugin.form-builder.definitions.manage",
            "label": "Import and Export Form Definitions",
            "supports_scope": false,
            "default_roles": ["admin"],
            "delegable": true
        },
        {
            "key": "plugin.form-builder.unsafe-code.manage",
            "label": "Manage Unsafe Form Code",
            "supports_scope": false,
            "default_roles": ["admin"],
            "delegable": false
        },
        {
            "key": "plugin.form-builder.global-settings.manage",
            "label": "Manage Global Form Builder Settings",
            "supports_scope": false,
            "default_roles": [
                "admin"
            ]
        },
        {
            "key": "plugin.form-builder.bin.manage",
            "label": "Manage the Form Builder Bin",
            "supports_scope": false,
            "default_roles": [
                "admin"
            ],
            "delegable": true
        }
    ],
    "store": {
        "url": "https://jyavani.com/plugin",
        "slug": "form-builder"
    },
    "license": "MIT",
    "dependencies": {
        "js": [
            "modal-helpers",
            "media-selector",
            "file-selector"
        ]
    },
    "admin": {
        "pages": [
            {
                "route": "admin/tools/form-builder",
                "file": "admin/index.php",
                "title": "Form Builder",
                "permission": "plugin.form-builder.workspace.access",
                "roles": [
                    "admin",
                    "author"
                ]
            },
            {
                "route": "admin/bin/form-builder/index",
                "file": "admin/bin.php",
                "title": "Bin Form Builder",
                "permission": "plugin.form-builder.bin.manage",
                "roles": [
                    "admin"
                ],
                "hidden": true
            }
        ],
        "nav": [
            {
                "label": "Form Builder",
                "icon": "list",
                "page": "admin/tools/form-builder",
                "parent": "pages",
                "roles": [
                    "admin",
                    "author"
                ]
            }
        ]
    }
}
